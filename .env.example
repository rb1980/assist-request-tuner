# Alternative to config.yaml: any setting as an environment variable (names in config.example.yaml).
# docker compose passes a .env file in this folder through to the container. Keep it private.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-admin-long-lived-token
AR_TUNER_TOKEN=replace-with-a-random-token
TZ=UTC
# HA_CONFIG_ACCESS=sftp
# LLM_API_KEY=replace-with-provider-api-key-or-leave-empty-to-disable
